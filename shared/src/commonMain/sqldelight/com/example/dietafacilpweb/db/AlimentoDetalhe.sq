-- Nutrientes extras dos alimentos cadastrados pelo usuário, também POR 1 g (ou 1 ml).
-- Ficam em tabela separada para não alterar tb_alimento nem o CatalogoInicial.

CREATE TABLE tb_alimento_detalhe (
    id_alimento           INTEGER NOT NULL PRIMARY KEY REFERENCES tb_alimento(id_alimento) ON DELETE CASCADE,
    gordura_saturada_g    REAL    NOT NULL,
    gordura_trans_g       REAL    NOT NULL,
    acucar_adicionado_g   REAL    NOT NULL
);

inserirDetalhe:
INSERT INTO tb_alimento_detalhe (id_alimento, gordura_saturada_g, gordura_trans_g, acucar_adicionado_g)
VALUES (?, ?, ?, ?);
