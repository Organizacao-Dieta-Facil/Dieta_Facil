@startuml
top to bottom direction

abstract class Usuario {
-String nome
-String email
-String senha
-char genero
-Image fotoPerfil
}

class UsuarioComum {
-double altura
-double pesoAtual
-char sexo
}

class Nutricionista {
-String CRN
-String Endereco
-String Descricao
}

class Meta {
-int nivelAtividade
-double pesoMeta
-double caloriasObjetivo
-double aguaObjetivo
-double sonoObjetivo
}

class Cardapio {
-String nomeCardapio
-double totalCalorias
-double totalCarboidratos
-double totalProteinas
-double totalGorduras
-double totalFibras
-double totalSodio
}

class Registro {
-double totalCalorias
-double totalCarboidratos
-double totalProteinas
-double totalGorduras
-double totalFibras
-double totalSodio
-double totalAgua
-String totalSono
-Date diaRegistrado
}

class Refeicao {
-String nome
-DateTime horario
}

class AlimentoConsumido {
-double quantidadeSelecionada
}

class Alimento {
-String nome
-double quantidadePadrao
-String unidade
-double valorEnergetico
-double carboidratos
-double proteinas
-double gorduras
-double fibras
-double sodio
}

class Consulta {
-DateTime dataHorario
-String status
}

class Avaliacao {
-int nota
-String comentario
}

class VinculoPaciente {
-Date dataInicio
-boolean ativo
-String notasPaciente
}

class Mensagens {
-String conteudo
-DateTime horario
}
class Agenda {
-DateTime horarioInicioAtendimento
-DateTime horarioFimAtendimento
}
class ResultadoBioimpedancia{
-DateTime data
-String id
-String sexo
-int idade
-double altura
-String tempoTeste
-int pontuacaoCorporal
-double peso
-double massaGorda
-double massaOssea
-double massaProteica
-double aguaCorporal
-double massaMuscular
-double musculoEsqueletico
-double pesoAlvoRecomendado
-double controlePeso
-double controleGordura
-double controleMuscular
-double imc
-double taxaGorduraCorporal
-double obesidadePercentual
-int grauGorduraVisceral
-int taxaMetabolicaBasal
-double pesoLivreGordura
-double gorduraSubcutanea
-double asmi
-int idadeDoCorpo
-double whr
-String equilibrioSuperior
-String equilibrioMaisBaixo
-String equilibrioParteSuperior
-double gorduraBracoEsquerdo
-double gorduraBracoDireito
-double gorduraTronco
-double gorduraPernaEsquerda
-double gorduraPernaDireita
-double musculoBracoEsquerdo
-double musculoBracoDireito
-double musculoTronco
-double musculoPernaEsquerda
-double musculoPernaDireita
-double impedancia20kHzBracoDireito
-double impedancia20kHzBracoEsquerdo
-double impedancia20kHzTronco
-double impedancia20kHzPernaDireita
-double impedancia20kHzPernaEsquerda
-double impedancia100kHzBracoDireito
-double impedancia100kHzBracoEsquerdo
-double impedancia100kHzTronco
-double impedancia100kHzPernaDireita
-double impedancia100kHzPernaEsquerda
}

' Herança
Usuario <|-- UsuarioComum
Usuario <|-- Nutricionista

' Relacionamentos do Usuário Comum (Meta como 0..1 - Opcional)
UsuarioComum "1" --> "1" Meta
UsuarioComum "1" --> "*" Cardapio
UsuarioComum "1" --> "*" Registro

' Estrutura de Alimentação
Cardapio "1" o-- "*" Refeicao
Registro "1" o-- "*" Refeicao
Refeicao "1" o-- "*" AlimentoConsumido
AlimentoConsumido "*" --> "1" Alimento

' Relacionamento de Criação de Cardápio
Nutricionista "1" --> "*" Cardapio

' Fluxo de Atendimento e Vínculo
Nutricionista "1" <-- "*" VinculoPaciente
UsuarioComum "1" <-- "1" VinculoPaciente
Nutricionista "1" --> "1" Agenda

' Consultas e Avaliações vinculadas à relação profissional
Agenda "1" --> "*" Consulta
VinculoPaciente "1" --> "1" Avaliacao
VinculoPaciente "1" --> "*" Mensagens
VinculoPaciente "1" --> "*" ResultadoBioimpedancia

@enduml
