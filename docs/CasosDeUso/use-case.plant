@startuml

left to right direction

actor "Usuário Comum" as UsuarioComum
actor "Nutricionista" as Nutricionista

rectangle "Sistema" {
    package "Cadastro" {
        usecase "Cadastrar Conta" as Register
        usecase "Realizar Login" as Login
    }

    Cadastro -[hidden]down-> Metas
    Metas -[hidden]down-> Cardapios
    Metas -[hidden]up-> Configuracoes
    Cardapios -[hidden]down-> Interacao
    Interacao -[hidden]down-> AcoesNutri

    package "Configuracoes" {
        usecase "Gerenciar Privacidade" as ManagePrivacy
        usecase "Redefinir Meta" as RedefMeta
    }

    package "Metas" {
        usecase "Definir Meta" as DefMeta
        usecase "Editar Meta" as EditMeta
    }

    package "Cardápios e Refeições" as Cardapios {
usecase "Gerenciar Refeicoes" as ManageMeal
        usecase "Consultar Cardápio" as CheckMenu
        usecase "Gerenciar Cardápio" as EditMenu
        usecase "Registrar Alimentos Consumidos" as RegMeal
        usecase "Verificar Histórico" as CheckHist
        usecase "Salvar Cardápio" as SaveMenu
        usecase "Navegar Cardápios" as ListMenu
        usecase "Carregar Cardápio" as LoadMenu
        usecase "Pesquisar Alimentos" as SearchFood
        usecase "Cadastrar Novos Alimentos" as AddNewFood
    }

    package "Interação com Nutricionista" as Interacao {
        usecase "Pesquisar Nutricionistas" as SearchNutr
        usecase "Agendar Consulta" as SchedCheckup
        usecase "Avaliar Nutricionistas" as ReviewNutr
        usecase "Chat com Nutricionista" as ChatNutr
    }

    package "Ações do Nutricionista" as AcoesNutri {
        usecase "Vincular Pacientes" as AddPati
        usecase "Remover Pacientes" as DelePati
        usecase "Gerenciar Agenda" as ManageAgenda
        usecase "Verificar Histórico de Pacientes" as CheckPatiHist
        usecase "Verificar Informações dos Pacientes" as CheckPatiInfo
        usecase "Prescrever Cardápios a Pacientes" as PrescribeMenu
        usecase "Editar Cardápios de Pacientes" as EditPatiMenu
        usecase "Chat com Paciente" as ChatPati
    }
}

' --- ASSOCIAÇÕES DO USUÁRIO COMUM (Esquerda para a Direita) ---

UsuarioComum --> Register
UsuarioComum --> Login
UsuarioComum --> DefMeta
UsuarioComum --> CheckMenu
UsuarioComum --> EditMenu
UsuarioComum --> RegMeal
UsuarioComum --> CheckHist
UsuarioComum --> SaveMenu
UsuarioComum --> ListMenu
UsuarioComum --> LoadMenu
UsuarioComum --> SearchFood
UsuarioComum --> AddNewFood
UsuarioComum --> SearchNutr
UsuarioComum --> SchedCheckup
UsuarioComum --> ReviewNutr
UsuarioComum --> ChatNutr
UsuarioComum --> RedefMeta
UsuarioComum --> ManagePrivacy

' --- ASSOCIAÇÕES DO NUTRICIONISTA (Direita para a Esquerda) ---
Register <-- Nutricionista
Login <-- Nutricionista
AddPati <-- Nutricionista
DelePati <-- Nutricionista
ManageAgenda <-- Nutricionista
CheckPatiHist <-- Nutricionista
CheckPatiInfo <-- Nutricionista
PrescribeMenu <-- Nutricionista
EditPatiMenu <-- Nutricionista
ChatPati <-- Nutricionista
ManagePrivacy <-- Nutricionista
EditMeta <-- Nutricionista

' --- RELACIONAMENTOS DE EXTENSÃO (Internos) ---
EditMenu <-right-. ManageMeal : <<extend>>
RegMeal <-right-. ManageMeal : <<extend>>
EditPatiMenu <-left-. ManageMeal  : <<extend>>
PrescribeMenu <-left-. ManageMeal  : <<extend>>

@enduml 
