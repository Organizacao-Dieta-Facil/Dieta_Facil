@startuml
top to bottom direction

abstract class Usuario {
-String nome
-String email
-String senha
-char genero
-Image fotoPerfil
}

class UsuarioComum {
-double altura
-double pesoAtual
-char sexo
}

class Nutricionista {
-String CRN
-String Endereco
-String Descricao
}

class Meta {
-int nivelAtividade
-double pesoMeta
-double caloriasObjetivo
}

class Cardapio {
-String nomeCardapio
-double totlCalorias
-double totalCarboidratos
-double totalProteinas
-double totalGorduras
-double totalFibras
-double totalSodio
}

class Registro {
-double totlCalorias
-double totalCarboidratos
-double totalProteinas
-double totalGorduras
-double totalFibras
-double totalSodio
-double totalAgua
-Date diaRegistrado
}

class Refeicao {
-String nome
}

class AlimentoConsumido {
-double quantidadeSelecionada
}

class Alimento {
-String nome
-double quantidadePadrao
-String unidade
-double valorEnergetico
-double carboidratos
-double proteinas
-double gorduras
-double fibras
-double sodio
}

class Consulta {
-DateTime dataHorario
-String status
}

class Avaliacao {
-int nota
-String comentario
}

class VinculoPaciente {
-Date dataInicio
-boolean ativo
}

class Mensagens {
-String conteudo
-DateTime horario
}
' Herança
Usuario <|-- UsuarioComum
Usuario <|-- Nutricionista

' Relacionamentos do Usuário Comum (Meta como 0..1 - Opcional)
UsuarioComum "1" --> "1" Meta
UsuarioComum "1" --> "*" Cardapio
UsuarioComum "1" --> "*" Registro

' Estrutura de Alimentação
Cardapio "1" o-- "*" Refeicao
Registro "1" o-- "*" Refeicao
Refeicao "1" o-- "*" AlimentoConsumido
AlimentoConsumido "*" --> "1" Alimento

' Relacionamento de Criação de Cardápio
Nutricionista "1" --> "*" Cardapio

' Fluxo de Atendimento e Vínculo
Nutricionista "1" <-- "*" VinculoPaciente
UsuarioComum "1" <-- "*" VinculoPaciente

' Consultas e Avaliações vinculadas à relação profissional
VinculoPaciente "1" --> "*" Consulta
VinculoPaciente "1" --> "1" Avaliacao
VinculoPaciente "1" --> "*" Mensagens

@enduml
